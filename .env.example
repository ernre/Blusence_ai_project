VPE_CONFIG=configs/base.yaml
# local | fashn | idm_vton
VPE_TRYON_PROVIDER=local
FASHN_API_URL=https://api.fashn.ai
FASHN_API_KEY=
FASHN_MODEL_NAME=tryon-v1.6
FASHN_MODE=balanced
FASHN_CATEGORY=auto
FASHN_GARMENT_PHOTO_TYPE=auto
FASHN_SEGMENTATION_FREE=true
FASHN_MODERATION_LEVEL=permissive
FASHN_NUM_SAMPLES=1
FASHN_OUTPUT_FORMAT=png
FASHN_RETURN_BASE64=false
IDM_VTON_SPACE_ID=yisol/IDM-VTON
IDM_VTON_API_NAME=/tryon
IDM_VTON_HF_TOKEN=
IDM_VTON_AUTO_MASK=true
IDM_VTON_AUTO_CROP=false
IDM_VTON_DENOISE_STEPS=20
IDM_VTON_SEED=42
IDM_VTON_TIMEOUT_SECONDS=600
IDM_VTON_NON_COMMERCIAL_ACK=false
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://vpe:vpe@postgres:5432/vpe
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
